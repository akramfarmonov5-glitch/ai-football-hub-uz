# Copy to .env.local and adjust for your environment.
# These NEXT_PUBLIC_* values are inlined into the client bundle at build time.

# Backend REST API base (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Saytning o'z manzili. Deploy'da MAJBURIY: metadata, canonical havolalar,
# OG taglar va sitemap shunga qarab quriladi. Belgilanmasa hammasi
# localhost'ni ko'rsatadi va Google saytni to'g'ri indeksatsiya qila olmaydi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram bot havolasi (sarlavhadagi tugma)
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/
