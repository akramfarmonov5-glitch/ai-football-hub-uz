# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi — maxfiy kalitlarni faqat o'sha yerda saqlang.

# --- Umumiy ---
PROJECT_NAME="AI Football Hub Uzbekistan"

# SQLite uchun absolyut yo'l tavsiya etiladi, aks holda serverni qayerdan
# ishga tushirsangiz, o'sha yerda yangi bo'sh baza yaratiladi.
# Bo'sh qoldirsangiz — backend/futbol.db avtomatik ishlatiladi.
DATABASE_URL=""

# --- AI (Google Gemini) ---
# Kalit: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Telegram bot (@BotFather) ---
TELEGRAM_BOT_TOKEN=""

# Botdagi havolalar shu manzilga ishora qiladi
PUBLIC_SITE_URL="http://localhost:3000"

# --- Xavfsizlik ---
# MAJBURIY: /admin/* endpointlari uchun X-Admin-Token qiymati.
# Kuchli tasodifiy qiymat yarating:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=""

# JWT imzolash uchun (hozircha ishlatilmaydi, kelajakdagi foydalanuvchi auth uchun)
SECRET_KEY=""

# --- CORS: frontend manzillari (JSON ro'yxat) ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Tashqi futbol API (ixtiyoriy) ---
# Kalit: https://www.api-football.com/  (bepul tarif: kuniga 100 so'rov)
# Bo'sh bo'lsa — simulyatsiya rejimi ishlaydi (o'yinlar avtomatik yaratiladi).
API_FOOTBALL_KEY=""
# Kuzatiladigan ligalar (API-Football league ID): 39=EPL, 140=La Liga, 1000=UZ Superliga
# Bo'sh qoldirilsa — barcha jonli o'yinlar olinadi.
API_FOOTBALL_LEAGUES="39,140"
# So'rovlar orasidagi vaqt. 900s = kuniga ~96 so'rov (bepul tarif limiti 100).
API_FOOTBALL_POLL_SECONDS=900

# --- Simulyator ---
# Bir o'yin daqiqasi necha soniyada o'tadi (kichikroq = tezroq)
SIMULATION_INTERVAL_SECONDS=10
