# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi — maxfiy kalitlarni faqat o'sha yerda saqlang.

# --- Umumiy ---
PROJECT_NAME="AI Football Hub Uzbekistan"

# SQLite uchun absolyut yo'l tavsiya etiladi, aks holda serverni qayerdan
# ishga tushirsangiz, o'sha yerda yangi bo'sh baza yaratiladi.
# Bo'sh qoldirsangiz — backend/futbol.db avtomatik ishlatiladi.
DATABASE_URL=""

# --- AI: asosiy yo'l (Gemini API kaliti) ---
# Kalit: https://aistudio.google.com/ yoki console.cloud.google.com/apis/credentials
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- AI: zaxira yo'l (Vertex AI + service account) — ixtiyoriy ---
# Asosiy kalit ishlamay qolsa (limit, o'chirilgan kalit, tarmoq) so'rov
# avtomatik shu yo'ldan yuboriladi. Ikkalasi ham ishlamasa AI matnlari
# o'zbekcha shablonlarga tushadi — sayt baribir ishlaydi.
GCP_PROJECT_ID=""
VERTEX_LOCATION="global"
# Service account JSON fayli (backend/ ga nisbatan yoki absolyut yo'l).
# Bo'sh bo'lsa GOOGLE_APPLICATION_CREDENTIALS, undan keyin ADC ishlatiladi.
VERTEX_CREDENTIALS_FILE=""
# Vertex'da model nomi boshqacha bo'lsa (bo'sh = GEMINI_MODEL bilan bir xil)
VERTEX_MODEL=""

# --- Telegram bot (@BotFather) ---
TELEGRAM_BOT_TOKEN=""

# Botdagi havolalar shu manzilga ishora qiladi
PUBLIC_SITE_URL="http://localhost:3000"

# --- Xavfsizlik ---
# MAJBURIY: /admin/* endpointlari uchun X-Admin-Token qiymati.
# Kuchli tasodifiy qiymat yarating:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=""

# JWT imzolash uchun (hozircha ishlatilmaydi, kelajakdagi foydalanuvchi auth uchun)
SECRET_KEY=""

# --- CORS: frontend manzillari (JSON ro'yxat) ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- TheSportsDB: haqiqiy ma'lumotning asosiy manbai (bepul) ---
# Bepul kalitida O'zbekiston Superligasi bor. "3" — ochiq sinov kaliti;
# o'z bepul kalitingizni thesportsdb.com dan olish tavsiya etiladi.
# Cheklov: bepul tarifda jonli daqiqama-daqiqa hisob yo'q (u $9/oy tarifida).
SPORTSDB_ENABLED=true
SPORTSDB_API_KEY="3"
# 4794=O'zbekiston Superligasi, 4328=Angliya Premyer-ligasi, 4335=La Liga
SPORTSDB_LEAGUES="4794,4328,4335"
SPORTSDB_POLL_SECONDS=600

# --- API-Football (ixtiyoriy, pullik) ---
# Qo'yilsa TheSportsDB o'rniga shu ishlatiladi (jonli hisob bilan).
# Kalit: https://www.api-football.com/  (bepul tarif: kuniga 100 so'rov)
# Bo'sh bo'lsa — simulyatsiya rejimi ishlaydi (o'yinlar avtomatik yaratiladi).
API_FOOTBALL_KEY=""
# Kuzatiladigan ligalar (API-Football league ID): 39=EPL, 140=La Liga, 1000=UZ Superliga
# Bo'sh qoldirilsa — barcha jonli o'yinlar olinadi.
API_FOOTBALL_LEAGUES="39,140"
# So'rovlar orasidagi vaqt. 900s = kuniga ~96 so'rov (bepul tarif limiti 100).
API_FOOTBALL_POLL_SECONDS=900

# --- Simulyator ---
# Bir o'yin daqiqasi necha soniyada o'tadi (kichikroq = tezroq)
SIMULATION_INTERVAL_SECONDS=10
